# ============================================
# ClipForge AI - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/clipforge?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here-generate-with-openssl-rand-base64-32"

# AI Providers (all optional - features degrade gracefully)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
ELEVENLABS_API_KEY=""
STABILITY_API_KEY=""

# Storage
STORAGE_PROVIDER="local"  # "local" | "s3"
STORAGE_LOCAL_PATH="./storage"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""

# Stripe (optional)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Application
NEXT_PUBLIC_APP_NAME="ClipForge AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# FFmpeg
FFMPEG_PATH="/opt/homebrew/bin/ffmpeg"
FFPROBE_PATH="/opt/homebrew/bin/ffprobe"
